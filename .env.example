# Copy the existing working values from your local backend/.env into Render.
# Never commit a real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
# Optional: direct URL for migrations. A Neon pooled URL is otherwise converted
# to its matching direct hostname automatically; runtime queries remain pooled.
DATABASE_URL_UNPOOLED=
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=YOUR_CURRENT_WORKING_GEMINI_MODEL
API_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALLOW_GUEST_SESSIONS=true
RUN_MIGRATIONS=true
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
NEO4J_ENABLED=true
NEO4J_URI=neo4j+s://YOUR-AURA-HOST
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=5
# Optional email delivery; off until its provider is configured.
EMAIL_WORKER_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
